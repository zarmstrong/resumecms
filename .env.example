# Copy this file to .env and fill in real values before running docker-compose.

# Username + password required to sign in to /editor
RESUMECMS_ADMIN_USERNAME=admin
RESUMECMS_APP_PASSWORD=change-me

# Random long string used to sign session cookies
RESUMECMS_SESSION_SECRET=change-this-to-a-long-random-string

# Optional: require a captcha on the /editor login form, on top of the
# existing rate limiting. Leave RESUMECMS_CAPTCHA_PROVIDER unset to disable.
#
# RESUMECMS_CAPTCHA_PROVIDER=turnstile   # "turnstile" (Cloudflare) or "recaptcha" (Google)
#
# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# RESUMECMS_TURNSTILE_SITE_KEY=
# RESUMECMS_TURNSTILE_SECRET_KEY=
#
# Google reCAPTCHA v2 — https://www.google.com/recaptcha/admin
# RESUMECMS_RECAPTCHA_SITE_KEY=
# RESUMECMS_RECAPTCHA_SECRET_KEY=
