# Copy this file to .env and fill in real values before running docker-compose.

# Username + password required to sign in to /editor. These are only read
# once, to seed the login credentials into the database on first boot —
# after that, change your password from Account Settings in the editor;
# editing these values later has no effect.
RESUMECMS_ADMIN_USERNAME=admin
RESUMECMS_APP_PASSWORD=change-me

# Random string used to sign session cookies. Required: the server refuses to
# start without one, with one shorter than 32 characters, or with a
# placeholder. Generate one with `openssl rand -hex 32`. Anyone holding it can
# sign themselves into the editor.
RESUMECMS_SESSION_SECRET=

# Optional: set when running behind a reverse proxy, so login rate limiting
# keys on the real client IP instead of the proxy's. Use the proxy's address
# as the container sees it (the "ip" field in the access log), not a hop
# count, unless the app port can't be reached except through the proxy.
# See the README's login rate-limiting notes before setting this.
# RESUMECMS_TRUST_PROXY=172.18.0.1

# Optional: require a captcha on the /editor login form, on top of the
# existing rate limiting. Leave RESUMECMS_CAPTCHA_PROVIDER unset to disable.
#
# RESUMECMS_CAPTCHA_PROVIDER=turnstile   # "turnstile" (Cloudflare) or "recaptcha" (Google)
#
# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# RESUMECMS_TURNSTILE_SITE_KEY=
# RESUMECMS_TURNSTILE_SECRET_KEY=
#
# Google reCAPTCHA v2 — https://www.google.com/recaptcha/admin
# RESUMECMS_RECAPTCHA_SITE_KEY=
# RESUMECMS_RECAPTCHA_SECRET_KEY=

# Optional: enable the MCP endpoint (POST /mcp) so Claude Code, Claude
# Desktop, or any other MCP client can read and edit the resume. Leave
# unset to keep it off. Must be at least 32 characters — generate one with
# `openssl rand -hex 32`. Anyone holding it has full editor access.
# RESUMECMS_MCP_TOKEN=
